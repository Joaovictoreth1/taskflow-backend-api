# Native development (SQLite). Set both DATABASE_URL and POSTGRES_PASSWORD
# as described in README.md for Docker Compose.
DATABASE_URL=sqlite:///./taskflow.db
POSTGRES_PASSWORD=

# Required; generate a random key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins, e.g. http://localhost:5173.
CORS_ALLOWED_ORIGINS=

# Optional demo seeder (local SQLite development only).
TASKFLOW_SEED_DEMO=
TASKFLOW_SEED_PASSWORD=
