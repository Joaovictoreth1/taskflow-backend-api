# Local development: generate SECRET_KEY with python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///./taskflow.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_REQUEST_BODY_BYTES=65536
CORS_ORIGINS=[]
RATE_LIMIT_STORAGE_URI=memory://

# Compose uses PostgreSQL and Redis on the private network. Supply matching values:
# POSTGRES_PASSWORD=
# COMPOSE_DATABASE_URL=postgresql+psycopg://taskflow:URL_ENCODED_PASSWORD@db:5432/taskflow
# API_PORT=8000
